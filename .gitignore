# ---- OS ----
Thumbs.db
Desktop.ini
.DS_Store

# ---- 編輯器 / IDE ----
.vscode/
.idea/
*.swp

# ---- Python (PC 上位機 / 中繼器工具) ----
__pycache__/
*.pyc
.venv/
venv/
env/
*.egg-info/

# ---- Arduino / 韌體建置產物 ----
build/
*.hex
*.elf
*.bin
*.o
*.d
*.map

# ---- MicroPython ----
*.mpy

# ---- sketch 內的 lib 副本（lib/ 才是單一真相；用 firmware/sync_lib.sh 產生） ----
firmware/*/protocol.h
firmware/*/protocol.cpp
firmware/*/protocol.py

# ---- 暫存 ----
*.log
*.tmp
~$*

# ---- KiCad（只追蹤原始檔：.kicad_pro/.sch/.pcb、庫表、.pretty、.kicad_sym） ----
*-backups/
.history/
*.bak
*-bak
fp-info-cache
~*.lck
_autosave-*
