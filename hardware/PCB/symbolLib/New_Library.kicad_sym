		(property "Description" "ADS1115 16-bit 4-ch I2C ADC breakout module, 10-pin 2.54mm, plugs into 1x10 female socket. Pin order: 1 VDD, 2 GND, 3 SCL, 4 SDA, 5 ADDR, 6 ALERT (open-drain, needs pull-up), 7 A0, 8 A1, 9 A2, 10 A3. VDD 2.0-5.5V; analog inputs within GND-0.3 .. VDD+0.3. ADDR: GND=0x48, VDD=0x49, SDA=0x4A, SCL=0x4B" (at 0 0 0) (effects (font (size 1.27 1.27)) (hide yes)))
