(footprint "RP2040_Super_Mini_Header"
	(version 20240108)
	(generator "claude")
	(layer "F.Cu")
	(descr "RP2040 SuperMini / RP2040-Zero, 23 pins. BOTH positions per pin: THT hole on 2.54mm grid for pin header + female socket (rows 15.24mm apart, GP9-13 in line with GP8/GP14; per Waveshare RP2040-Zero drawing: 1.38mm from long edge, 1.59mm from short edge), plus F.Cu rect SMD pad under the castellation (stamp hole) extending 1.5mm beyond the module edge for hand soldering, same pad number. Board 24x18 (SuperMini) / 23.5x18 (Zero, dashed line); extra 0.5mm is at USB end. Drill 1.0 for socket pins; place THT on back for engraved boards")
	(tags "RP2040 SuperMini Zero castellated header socket")
